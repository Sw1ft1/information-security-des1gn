import json
import yaml

class Supplier:
    def __init__(self, supplier_id, name, address, phone):
        self.supplier_id = supplier_id
        self.name = name
        self.address = address
        self.phone = phone

    def to_dict(self):
        return {
            'supplier_id': self.supplier_id,
            'name': self.name,
            'address': self.address,
            'phone': self.phone
        }

    @classmethod
    def from_dict(cls, data):
        return cls(data['supplier_id'], data['name'], data['address'], data['phone'])


class SupplierRepositoryJSON:
    def __init__(self, filename):
        self.filename = filename
        self.suppliers = self.read_from_file()

    def read_from_file(self):
        try:
            with open(self.filename, 'r') as file:
                data = json.load(file)
                return [Supplier.from_dict(item) for item in data]
        except (FileNotFoundError, json.JSONDecodeError):
            return []

    def write_to_file(self):
        with open(self.filename, 'w') as file:
            json.dump([supplier.to_dict() for supplier in self.suppliers], file, ensure_ascii=False, indent=4)

    def add_supplier(self, supplier):
        supplier.supplier_id = max((s.supplier_id for s in self.suppliers), default=0) + 1
        self.suppliers.append(supplier)
        self.write_to_file()

    def get_by_id(self, supplier_id):
        for supplier in self.suppliers:
            if supplier.supplier_id == supplier_id:
                return supplier
        return None

    def delete_supplier(self, supplier_id):
        self.suppliers = [s for s in self.suppliers if s.supplier_id != supplier_id]
        self.write_to_file()


class SupplierRepositoryYAML:
    def __init__(self, filename):
        self.filename = filename
        self.suppliers = self.read_from_file()

    def read_from_file(self):
        try:
            with open(self.filename, 'r') as file:
                data = yaml.safe_load(file)
                return [Supplier.from_dict(item) for item in data]
        except (FileNotFoundError, yaml.YAMLError):
            return []

    def write_to_file(self):
        with open(self.filename, 'w') as file:
            yaml.dump([supplier.to_dict() for supplier in self.suppliers], file, allow_unicode=True)

    def add_supplier(self, supplier):
        supplier.supplier_id = max((s.supplier_id for s in self.suppliers), default=0) + 1
        self.suppliers.append(supplier)
        self.write_to_file()

    def get_by_id(self, supplier_id):
        for supplier in self.suppliers:
            if supplier.supplier_id == supplier_id:
                return supplier
        return None

    def delete_supplier(self, supplier_id):
        self.suppliers = [s for s in self.suppliers if s.supplier_id != supplier_id]
        self.write_to_file()


if __name__ == "__main__":
    json_repo = SupplierRepositoryJSON("suppliers.json")
    yaml_repo = SupplierRepositoryYAML("suppliers.yaml")

    new_supplier = Supplier(0, "Автозапчасти Ltd", "Москва, ул. Ленина, 1", "123456789")
    json_repo.add_supplier(new_supplier)
    yaml_repo.add_supplier(new_supplier)

    print("JSON Repository Suppliers:")
    for supplier in json_repo.suppliers:
        print(supplier.to_dict())

    print("YAML Repository Suppliers:")
    for supplier in yaml_repo.suppliers:
        print(supplier.to_dict())

    supplier = json_repo.get_by_id(1)
    if supplier:
        print("Found Supplier in JSON:", supplier.to_dict())

    json_repo.delete_supplier(1)
    print("Suppliers after deletion in JSON:", [s.to_dict() for s in json_repo.suppliers])
