import sqlite3

class Supplier:
    def __init__(self, supplier_id, name, address, phone):
        self.supplier_id = supplier_id
        self.name = name
        self.address = address
        self.phone = phone

    def to_dict(self):
        return {
            'supplier_id': self.supplier_id,
            'name': self.name,
            'address': self.address,
            'phone': self.phone
        }

class SupplierRepository:
    def __init__(self, db_file):
        self.connection = sqlite3.connect(db_file)
        self.create_table()

    def create_table(self):
        with self.connection:
            self.connection.execute('''
                CREATE TABLE IF NOT EXISTS Suppliers (
                    supplier_id INTEGER PRIMARY KEY AUTOINCREMENT,
                    name TEXT NOT NULL,
                    address TEXT NOT NULL,
                    phone TEXT NOT NULL
                )
            ''')

    def add_supplier(self, supplier):
        with self.connection:
            cursor = self.connection.cursor()
            cursor.execute('''
                INSERT INTO Suppliers (name, address, phone)
                VALUES (?, ?, ?)
            ''', (supplier.name, supplier.address, supplier.phone))
            supplier.supplier_id = cursor.lastrowid

    def get_by_id(self, supplier_id):
        cursor = self.connection.cursor()
        cursor.execute("SELECT * FROM Suppliers WHERE supplier_id = ?", (supplier_id,))
        row = cursor.fetchone()
        if row:
            return Supplier(*row)
        return None

    def get_all_suppliers(self):
        cursor = self.connection.cursor()
        cursor.execute("SELECT * FROM Suppliers")
        rows = cursor.fetchall()
        return [Supplier(*row) for row in rows]

    def delete_supplier(self, supplier_id):
        with self.connection:
            self.connection.execute('DELETE FROM Suppliers WHERE supplier_id = ?', (supplier_id,))

    def close(self):
        self.connection.close()

if __name__ == "__main__":
    db = SupplierRepository("suppliers.db")
    supplier = Supplier(0, "Автозапчасти Ltd", "Москва, ул. Ленина, 1", "123456789")
    db.add_supplier(supplier)
    supplier = db.get_by_id(1)
    if supplier:
        print(supplier.to_dict())
    db.close()
