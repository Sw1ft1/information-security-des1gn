import sqlite3
from typing import List, Optional

class Part:
    def __init__(self, part_id: int, name: str, article: str, price: float, supplier_id: int):
        self.part_id = part_id
        self.name = name
        self.article = article
        self.price = price
        self.supplier_id = supplier_id

    def to_dict(self):
        return {
            "part_id": self.part_id,
            "name": self.name,
            "article": self.article,
            "price": self.price,
            "supplier_id": self.supplier_id
        }

class Supplier:
    def __init__(self, supplier_id: int, name: str, address: str, phone: str):
        self.supplier_id = supplier_id
        self.name = name
        self.address = address
        self.phone = phone

    def to_dict(self):
        return {
            "supplier_id": self.supplier_id,
            "name": self.name,
            "address": self.address,
            "phone": self.phone
        }

class PartsDatabase:
    def __init__(self, db_file: str):
        self.connection = sqlite3.connect(db_file)
        self.create_tables()

    def create_tables(self):
        with self.connection:
            self.connection.execute('''
                CREATE TABLE IF NOT EXISTS Suppliers (
                    supplier_id INTEGER PRIMARY KEY AUTOINCREMENT,
                    name TEXT,
                    address TEXT,
                    phone TEXT
                )
            ''')
            self.connection.execute('''
                CREATE TABLE IF NOT EXISTS Parts (
                    part_id INTEGER PRIMARY KEY AUTOINCREMENT,
                    name TEXT,
                    article TEXT,
                    price REAL,
                    supplier_id INTEGER,
                    FOREIGN KEY(supplier_id) REFERENCES Suppliers(supplier_id)
                )
            ''')

    def add_supplier(self, supplier: Supplier):
        with self.connection:
            cursor = self.connection.cursor()
            cursor.execute('''
                INSERT INTO Suppliers (name, address, phone)
                VALUES (?, ?, ?)
            ''', (supplier.name, supplier.address, supplier.phone))
            supplier.supplier_id = cursor.lastrowid

    def add_part(self, part: Part):
        with self.connection:
            cursor = self.connection.cursor()
            cursor.execute('''
                INSERT INTO Parts (name, article, price, supplier_id)
                VALUES (?, ?, ?, ?)
            ''', (part.name, part.article, part.price, part.supplier_id))
            part.part_id = cursor.lastrowid

    def get_all_parts(self) -> List[Part]:
        cursor = self.connection.cursor()
        cursor.execute("SELECT * FROM Parts")
        rows = cursor.fetchall()
        return [Part(*row) for row in rows]

    def get_all_suppliers(self) -> List[Supplier]:
        cursor = self.connection.cursor()
        cursor.execute("SELECT * FROM Suppliers")
        rows = cursor.fetchall()
        return [Supplier(*row) for row in rows]

    def get_part_by_id(self, part_id: int) -> Optional[Part]:
        cursor = self.connection.cursor()
        cursor.execute("SELECT * FROM Parts WHERE part_id = ?", (part_id,))
        row = cursor.fetchone()
        if row:
            return Part(*row)
        return None

    def delete_part(self, part_id: int):
        with self.connection:
            self.connection.execute("DELETE FROM Parts WHERE part_id = ?", (part_id,))

    def delete_supplier(self, supplier_id: int):
        with self.connection:
            self.connection.execute("DELETE FROM Suppliers WHERE supplier_id = ?", (supplier_id,))

    def close(self):
        self.connection.close()

if name == "__main__":
    db = PartsDatabase("parts_db.db")

    supplier1 = Supplier(0, "Supplier 1", "123 Main St", "1234567890")
    db.add_supplier(supplier1)

    part1 = Part(0, "Brake Pad", "A123", 250.0, supplier1.supplier_id)
    db.add_part(part1)

    parts = db.get_all_parts()
    for part in parts:
        print(part.to_dict())

    suppliers = db.get_all_suppliers()
    for supplier in suppliers:
        print(supplier.to_dict())

    db.delete_part(part1.part_id)
    db.delete_supplier(supplier1.supplier_id)

    db.close()
