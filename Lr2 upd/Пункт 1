import sqlite3

class Supplier:
    def __init__(self, name, address, phone):
        self.name = name
        self.address = address
        self.phone = phone

class Part:
    def __init__(self, name, article, price):
        self.name = name
        self.article = article
        self.price = price

class Purchase:
    def __init__(self, supplier_id, part_id, date, quantity):
        self.supplier_id = supplier_id
        self.part_id = part_id
        self.date = date
        self.quantity = quantity

class Database:
    def __init__(self, db_file):
        self.connection = sqlite3.connect(db_file)
        self.create_tables()

    def create_tables(self):
        with self.connection:
            self.connection.execute('''
                CREATE TABLE IF NOT EXISTS Suppliers (
                    supplier_id INTEGER PRIMARY KEY AUTOINCREMENT,
                    name TEXT,
                    address TEXT,
                    phone TEXT
                )
            ''')
            self.connection.execute('''
                CREATE TABLE IF NOT EXISTS Parts (
                    part_id INTEGER PRIMARY KEY AUTOINCREMENT,
                    name TEXT,
                    article TEXT,
                    price REAL
                )
            ''')
            self.connection.execute('''
                CREATE TABLE IF NOT EXISTS Purchases (
                    purchase_id INTEGER PRIMARY KEY AUTOINCREMENT,
                    supplier_id INTEGER,
                    part_id INTEGER,
                    date TEXT,
                    quantity INTEGER
                )
            ''')

    def add_supplier(self, supplier):
        with self.connection:
            cursor = self.connection.cursor()
            cursor.execute('''
                INSERT INTO Suppliers (name, address, phone)
                VALUES (?, ?, ?)
            ''', (supplier.name, supplier.address, supplier.phone))
            supplier_id = cursor.lastrowid
            return supplier_id

    def add_part(self, part):
        with self.connection:
            cursor = self.connection.cursor()
            cursor.execute('''
                INSERT INTO Parts (name, article, price)
                VALUES (?, ?, ?)
            ''', (part.name, part.article, part.price))
            part_id = cursor.lastrowid
            return part_id

    def add_purchase(self, purchase):
        with self.connection:
            cursor = self.connection.cursor()
            cursor.execute('''
                INSERT INTO Purchases (supplier_id, part_id, date, quantity)
                VALUES (?, ?, ?, ?)
            ''', (purchase.supplier_id, purchase.part_id, purchase.date, purchase.quantity))

    def get_suppliers(self):
        cursor = self.connection.cursor()
        cursor.execute("SELECT * FROM Suppliers")
        return cursor.fetchall()

    def get_parts(self):
        cursor = self.connection.cursor()
        cursor.execute("SELECT * FROM Parts")
        return cursor.fetchall()

    def get_purchases(self):
        cursor = self.connection.cursor()
        cursor.execute("SELECT * FROM Purchases")
        return cursor.fetchall()

    def close(self):
        self.connection.close()

if __name__ == "__main__":
    db = Database("parts_simple.db")

    supplier = Supplier("Автозапчасти Ltd", "Москва, ул. Ленина, 1", "123456789")
    supplier_id = db.add_supplier(supplier)

    part = Part("Тормозные колодки", "BOS123", 1500.0)
    part_id = db.add_part(part)

    purchase = Purchase(supplier_id, part_id, "2024-12-21", 10)
    db.add_purchase(purchase)

    print("Поставщики:")
    for s in db.get_suppliers():
        print(s)

    print("Запчасти:")
    for p in db.get_parts():
        print(p)

    print("Покупки:")
    for pu in db.get_purchases():
        print(pu)

    db.close()
