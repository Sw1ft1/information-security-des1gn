import json

class Supplier:
    def __init__(self, supplier_id, name, address, phone):
        self.supplier_id = supplier_id
        self.name = name
        self.address = address
        self.phone = phone

    def to_dict(self):
        return {
            'supplier_id': self.supplier_id,
            'name': self.name,
            'address': self.address,
            'phone': self.phone
        }

    @classmethod
    def from_dict(cls, data):
        return cls(data['supplier_id'], data['name'], data['address'], data['phone'])


class SupplierRepository:
    def __init__(self, filename):
        self.filename = filename
        self.suppliers = self.read_from_file()

    def read_from_file(self):
        try:
            with open(self.filename, 'r') as file:
                data = json.load(file)
                return [Supplier.from_dict(item) for item in data]
        except (FileNotFoundError, json.JSONDecodeError):
            return []

    def write_to_file(self):
        with open(self.filename, 'w') as file:
            json.dump([supplier.to_dict() for supplier in self.suppliers], file, indent=4)

    def get_by_id(self, supplier_id):
        for supplier in self.suppliers:
            if supplier.supplier_id == supplier_id:
                return supplier
        return None

    def add_supplier(self, supplier):
        supplier.supplier_id = max((s.supplier_id for s in self.suppliers), default=0) + 1
        self.suppliers.append(supplier)
        self.write_to_file()

    def get_all(self):
        return self.suppliers

    def delete_supplier(self, supplier_id):
        self.suppliers = [s for s in self.suppliers if s.supplier_id != supplier_id]
        self.write_to_file()


